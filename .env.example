# Port the API listens on
PORT=3000

# development or production
NODE_ENV=development

# Connection string for running the API on your machine (npm run start:dev).
# User, password, database and port must match the values below.
DATABASE_URL=postgresql://dealora:change-me@localhost:5433/dealora

# Database created by the Docker Postgres container
POSTGRES_DB=dealora

# Database user created by the Docker Postgres container
POSTGRES_USER=dealora

# Database password. Use URL-safe characters, since it is part of DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Host port for the Docker Postgres container
DB_PORT=5433

# JWT signing secret. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-long-random-secret

# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
